SubDir TOP ;

SubDirHdrs $(SUBDIR)/src/app ;
SubDirHdrs $(SUBDIR)/src/ui ;
SubDirHdrs $(SUBDIR)/src/engine ;
SubDirHdrs $(SUBDIR)/src/util ;

Main FricoBurner :
	src/app/main.cpp
	src/app/FricoBurnerApp.cpp
	src/ui/MainWindow.cpp
	src/ui/FileListView.cpp
	src/ui/CapacityBarView.cpp
	src/ui/MediaPresetMenu.cpp
	src/ui/BurnerDeviceMenu.cpp
	src/ui/ProgressPanel.cpp
	src/ui/DiscCopyPanel.cpp
	src/ui/SaveImagePanel.cpp
	src/ui/AboutWindow.cpp
	src/engine/BurnEngine.cpp
	src/engine/ScanTask.cpp
	src/engine/ImageProvisionTask.cpp
	src/engine/ImagePopulateTask.cpp
	src/engine/BackendCapabilities.cpp
	src/engine/BurnTask.cpp
	src/engine/DiscCopyTask.cpp
	src/util/SizeEstimator.cpp
	src/util/ExternalProcess.cpp
	src/util/ExternalProcessLineReader.cpp
	src/util/TempImageRegistry.cpp
	;

LINKLIBS on FricoBurner += -lbe -ltranslation -ltracker -lstdc++ ;

LOCATE on FricoBurner = $(SUBDIR)/bin ;

